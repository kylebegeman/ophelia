{
  "repo": "ophelia-fixtures/fixture-postgres-api",
  "environments": {
    "staging": {
      "secrets": [
        {"name": "OPHELIA_DEPLOY_HOST"},
        {"name": "OPHELIA_DEPLOY_PORT"},
        {"name": "OPHELIA_DEPLOY_USER"},
        {"name": "OPHELIA_DEPLOY_KEY"},
        {"name": "GHCR_TOKEN"}
      ]
    },
    "production": {
      "secrets": [
        {"name": "OPHELIA_DEPLOY_HOST"},
        {"name": "OPHELIA_DEPLOY_PORT"},
        {"name": "OPHELIA_DEPLOY_USER"},
        {"name": "OPHELIA_DEPLOY_KEY"},
        {"name": "GHCR_TOKEN"}
      ]
    }
  },
  "branch_protection": {
    "next": {
      "protected": true,
      "required_status_checks": ["tests", "validate"]
    },
    "master": {
      "protected": true,
      "required_status_checks": ["tests", "validate"]
    }
  },
  "labels": ["release:major", "release:minor", "release:patch"],
  "workflows": [
    ".github/workflows/ophelia-release.yml",
    ".github/workflows/ophelia-staging.yml"
  ]
}

